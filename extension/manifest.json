{
  "manifest_version": 3,
  "name": "Authenticator",
  "version": "0.5.1",
  "description": "TOTP and HOTP authenticator. Codes come from an encrypted vault that Firefox Sync can carry between your computers; no data is collected.",
  "developer": {
    "name": "Cimotto",
    "url": "https://github.com/Abe90/authenticator"
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting", "storage"],
  "background": { "scripts": ["background/scan.mjs", "background/vault-copy.mjs", "background/open-windows.mjs"], "type": "module" },
  "icons": { "48": "assets/icons/logo-48.png", "96": "assets/icons/logo-96.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "authenticator@cimot.to",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "action": {
    "default_icon": { "16": "assets/icons/logo-16.png", "32": "assets/icons/logo-32.png", "64": "assets/icons/logo-64.png" },
    "default_title": "Authenticator",
    "default_popup": "popup/popup.html"
  }
}
